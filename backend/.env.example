# Copia a backend/.env y ajusta. Todo es opcional (hay defaults).

# URL de SQLite; si no se define se usa backend/data/ferreteria.db
# (ejemplo: sqlite://C:/ruta/al/ferreteria.db)
DATABASE_URL=

# Orígenes CORS permitidos, separados por coma
CORS_ORIGINS=http://localhost:5173

# OpenTelemetry: TODO futuro — montar todo el stack de OTel (collector, backend
# de traces) apropiadamente vía docker compose. Por ahora dejar estas variables
# sin asignar y usar los defaults locales.
# Exporta spans/métricas a consola
OTEL_CONSOLE=false

# OpenTelemetry: endpoint OTLP/gRPC — déjalo sin asignar por ahora; se
# configurará junto con el stack OTel de docker compose (requiere instalar
# `opentelemetry-exporter-otlp-proto-grpc`; sin él solo se registra un warning)
OTLP_ENDPOINT=

# Rutas alternativas de los CSVs de seed
PRODUCTS_CSV=
SALES_CSV=
