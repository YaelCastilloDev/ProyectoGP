              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "{{storeId}}", "purchases"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"sku\": \"SKU001\", \"cantidad\": 1 },\n    { \"sku\": \"SKU004\", \"cantidad\": 2 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Importar histórico de ventas (ejemplo, no toca stock)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 201', () => pm.response.to.have.status(201));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{storeId}}/sales/import",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "{{storeId}}", "sales", "import"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rows\": [\n    { \"ticket_id\": \"VIMP1\", \"sku\": \"SKU001\", \"cantidad\": 1, \"fecha\": \"2026-01-15\" }\n  ]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Recomendaciones",
      "item": [
